{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "checkJs": false,
    "verbatimModuleSyntax": true,
    "strict": false,
    "noImplicitAny": false,
    "outDir": "build/ts",
    "rootDir": ".",
    "removeComments": false,
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "lib/**/*.ts"],
  "exclude": ["build", "node_modules"]
}
