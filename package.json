    "build/*.mjs",
    "build/v64*.wasm"
  ],
  "main": "build/libv64.mjs",
  "types": "v64.d.ts",
  "repository": "github:debugdoctor/v64",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "google-closure-compiler": "20260920.0.0",
    "typescript": "^7.0.2"
  }
}
