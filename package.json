{
  "name": "v64",
  "version": "0.5",
  "license": "BSD-2-Clause",
  "description": "16/32/64-bit x86 PC emulator and x86-to-wasm JIT, running in the browser",
  "homepage": "https://github.com/debugdoctor/v64",
  "files": [
    "Readme.md",
    "LICENSE",
    "v64.d.ts",
    "build/libv64*.js",
